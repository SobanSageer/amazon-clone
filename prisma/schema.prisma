generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  createdAt    DateTime   @default(now())
  addresses    Address[]
  cartItems    CartItem[]
  orders       Order[]
  reviews      Review[]
  listItems    ListItem[]
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  street    String
  unit      String?
  city      String
  state     String
  zip       String
  country   String  @default("US")
  isDefault Boolean @default(false)
  // Deleted from the address book but kept, because past orders still point at it.
  archived  Boolean @default(false)
  orders    Order[]

  @@index([userId])
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  imageUrl String?
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  description String
  brand       String?
  price       Decimal     @db.Decimal(10, 2)
  thumbnail   String
  images      String[]
  rating      Float
  ratingCount Int
  stock       Int
  specs       Json?
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]
  listItems   ListItem[]

  @@index([categoryId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int
  title      String?
  body       String
  verified   Boolean  @default(false)
  sourceKey  String?  @unique
  createdAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId, createdAt])
}

model CartItem {
  id            String  @id @default(cuid())
  userId        String?
  user          User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String?
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int     @default(1)
  savedForLater Boolean @default(false)

  @@unique([userId, productId])
  @@unique([sessionId, productId])
  @@index([sessionId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  addressId     String
  address       Address     @relation(fields: [addressId], references: [id])
  status        String      @default("placed")
  shippingSpeed String      @default("standard")
  promoCode     String?
  discount      Decimal     @default(0) @db.Decimal(10, 2)
  taxRate       Decimal     @default(0) @db.Decimal(6, 4)
  cancelledAt   DateTime?
  subtotal      Decimal     @db.Decimal(10, 2)
  tax           Decimal     @db.Decimal(10, 2)
  shippingFee   Decimal     @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)
  paymentBrand  String
  paymentLast4  String
  createdAt     DateTime    @default(now())
  items         OrderItem[]

  @@index([userId, createdAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  titleSnapshot String
  priceSnapshot Decimal @db.Decimal(10, 2)
  imageSnapshot String?
  quantity      Int

  @@index([orderId])
}

model ListItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}
